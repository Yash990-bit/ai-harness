# ============================================================
# AI Harness Hackathon — Evaluator Configuration
# ============================================================
# The evaluator provides this key externally:
#   export AI_API_KEY="PROVIDED_KEY"
# Do NOT commit real credentials to this file.
AI_API_KEY=

# Optional: override the provider and model.
# If unset, the harness auto-selects based on available CLIs.
# AI_PROVIDER=
# AI_MODEL=

# ============================================================
# TaskIt Authentication (optional — for full-stack mode only)
# ============================================================
# Required when TaskIt has FIREBASE_AUTH_ENABLED=True
# The admin user must exist in TaskIt with is_admin=True
ODIN_ADMIN_USER=
ODIN_ADMIN_PASSWORD=

# Firebase API key — used by TaskIt backend for email/password auth
ODIN_FIREBASE_API_KEY=
